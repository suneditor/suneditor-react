{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		// The playground imports the package name; resolve it to the source, not to a stale `dist/`.
		"paths": { "@suneditor/suneditor-react": ["./src/index.ts"] }
	},
	"include": ["src", "test", "playground", "*.config.ts"]
}
