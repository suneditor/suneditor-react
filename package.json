{
	"name": "@suneditor/suneditor-react",
	"version": "1.0.0",
	"description": "Official React component for SunEditor",
	"author": "Yi JiHong",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"release-note.md"
	],
	"sideEffects": false,
	"scripts": {
		"dev": "vite",
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
		"prepublishOnly": "npm run check",
		"release:archive": "bash scripts/release-archive.sh"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"suneditor": "^3.4.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.10",
		"react": "^19.0.0",
		"react-dom": "^19.3.1",
		"suneditor": "^3.4.1",
		"tsup": "^8.5.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"homepage": "https://github.com/suneditor/suneditor-react#readme",
	"bugs": {
		"url": "https://github.com/suneditor/suneditor-react/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/suneditor/suneditor-react.git"
	},
	"keywords": [
		"suneditor",
		"react",
		"nextjs",
		"wysiwyg",
		"wysiwyg-editor",
		"rich-text-editor",
		"text-editor",
		"html-editor",
		"editor",
		"react-component",
		"react-editor"
	],
	"engines": {
		"node": ">=20"
	}
}
